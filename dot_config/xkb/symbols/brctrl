default partial alphanumeric_keys
xkb_symbols "basic" {
    include "br(abnt2)"
    name[Group1] = "Portuguese (Brazil)";

    // ABNT2 AB10 is semicolon. Control on that key must emit C-/ for undo.
    key <AB10> {
        type[Group1] = "FOUR_LEVEL_CTRL",
        symbols[Group1] = [ semicolon, colon, slash, question ]
    };
};
